# Copy to .env; deno task dev, serve and migrate read it. Never commit .env.

# --- Required ---------------------------------------------------------------
# Where the API keeps its record. The compose file's Postgres:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Where sign-in happens (the AuthKit issuer) and whose sign-in counts.
AUTH_ISSUER=https://your-tenant.authkit.app
ALLOWED_SUBJECT=user_xxx

# --- Optional ---------------------------------------------------------------
# The port the API listens on. 8000 when unset.
# PORT=8000
# The issuer's key set, when its metadata does not say or names a host this
# machine cannot reach.
# AUTH_JWKS_URL=
# The origin discovery documents name, when the proxy's headers are not enough.
# PUBLIC_ORIGIN=https://trainer.marcoazzurrini.com
# Withings: needed to refresh the account's tokens and to seed them.
# WITHINGS_CLIENT_ID=
# WITHINGS_CLIENT_SECRET=
# Filing coach issues on GitHub.
# GITHUB_TOKEN=
# GITHUB_REPO=marcoazzurrini/personal-trainer

# Web dashboard: opt in separately from the connector's credential policy.
# Exact issuer from a WorkOS web-session JWT, not the MCP discovery issuer.
# WEB_AUTH_ISSUER=https://api.workos.com
# The WorkOS application used by web/.env (WORKOS_CLIENT_ID).
# WEB_AUTH_CLIENT_ID=client_xxx
# WorkOS publishes this application's session-signing keys here.
# WEB_AUTH_JWKS_URL=https://api.workos.com/sso/jwks/client_xxx
# Web sessions authorize only GET /api/bodyweight. ALLOWED_SUBJECT applies too.

# --- Tests only -------------------------------------------------------------
# Where the tests find the running API and the database they may truncate.
# API_URL=http://127.0.0.1:8000/api
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Stubs the tests point the API at; never set these for real use.
# WITHINGS_API_BASE=
# GITHUB_API_BASE=
