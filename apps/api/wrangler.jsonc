{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "personal-trainer-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-03",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "trainer.marcoazzurrini.com", "custom_domain": true },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-trainer",
      "database_id": "a229a9f7-287b-48fd-ba7a-e91fa9179a39",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "observability": { "enabled": true },
  // Zod's locale index only; see src/shared/zod_locales.ts for why.
  "alias": { "../locales/index.js": "./src/shared/zod_locales.ts" },
  "triggers": { "crons": ["0 */6 * * *"] },
}
