# Copy to .env for local Workers runs. Never commit .env.
# Hosted values are Worker secrets: `bunx wrangler secret put <NAME>`.

# The model provider's key.
ANTHROPIC_API_KEY=

# The secret the API accepts from this Worker. Use the same value as the
# API's COACH_AGENT_TOKEN: at least 32 characters, with no dot.
# Generate with: openssl rand -hex 32
COACH_AGENT_TOKEN=
