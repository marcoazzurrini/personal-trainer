{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "trainer-coach",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // No route and no workers.dev address: the dashboard Worker reaches this one
  // only through its service binding, after checking who is signed in.
  "workers_dev": false,
  "preview_urls": false,
  "services": [{ "binding": "API", "service": "personal-trainer-api" }],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  // One Durable Object class per agent; append a tag for each new agent and
  // never rewrite a deployed entry.
  "migrations": [
    {
      "tag": "flue-class-FlueCoachAgent",
      "new_sqlite_classes": ["FlueCoachAgent"],
    },
  ],
}
