{
  "tasks": {
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno check api/index.ts db/migrate.ts",
    "db": "docker compose up -d --wait",
    "migrate": "deno run --env-file --allow-net --allow-env --allow-read=db/migrations db/migrate.ts",
    "serve": "deno run --env-file --allow-net --allow-env --allow-read api/index.ts",
    "dev": "deno task migrate && deno run --env-file --watch --allow-net --allow-env --allow-read api/index.ts",
    "start": "deno run --allow-net --allow-env --allow-read=db/migrations db/migrate.ts && deno run --allow-net --allow-env --allow-read api/index.ts",
    "test": "deno test --allow-net --allow-env --allow-read tests/",
    "hooks": "scripts/lefthook install"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4",
    "@hono/zod-openapi": "jsr:@hono/zod-openapi@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "ajv": "npm:ajv@^8",
    "fast-check": "npm:fast-check@^4.9.0",
    "postgres": "npm:postgres@^3.4"
  },
  "fmt": {
    "exclude": [
      "docs/",
      "plugin/"
    ]
  }
}
