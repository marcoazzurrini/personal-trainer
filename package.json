{
  "name": "personal-trainer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "bun run --cwd apps/api dev",
    "fmt": "oxfmt",
    "lint": "oxlint --deny-warnings",
    "check": "tsc --noEmit",
    "check:style": "ultracite check",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages",
    "fix": "ultracite fix",
    "backup": "bun run --cwd packages/db backup",
    "test": "bun run --cwd apps/api test && bun run --cwd apps/api test:d1 && bun run --cwd packages/db test"
  },
  "devDependencies": {
    "@swc/core": "1.16.18",
    "@types/bun": "1.4.2",
    "@types/node": "24.13.4",
    "dependency-cruiser": "18.3.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "wrangler": "4.131.2"
  },
  "engines": {
    "bun": "1.4.2",
    "node": ">=24.20.0 <25"
  },
  "packageManager": "bun@1.4.2"
}
