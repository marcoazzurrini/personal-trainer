# Copy to web/.env. All variables are server-only. Never prefix these with VITE_.
WORKOS_CLIENT_ID=client_xxx
WORKOS_API_KEY=sk_test_replace_me
# Also defines the dashboard's public origin for redirects and CSRF checks.
# Use the public HTTPS address when hosted; HTTP is allowed only on localhost.
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
WORKOS_COOKIE_MAX_AGE=604800
WORKOS_COOKIE_SAMESITE=lax
# Keep the cookie host-only: do not set WORKOS_COOKIE_DOMAIN.
ALLOWED_SUBJECT=user_xxx
# API origin only, without /api. Remote addresses must use HTTPS.
TRAINER_API_ORIGIN=http://127.0.0.1:8000
