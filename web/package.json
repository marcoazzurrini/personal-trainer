{
  "name": "trainer-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --port 3000",
    "build": "vite build",
    "icons": "node scripts/generate-icons.mjs",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:container": "node --test tests/container.test.mjs"
  },
  "dependencies": {
    "@tanstack/charts": "0.17.0",
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-start": "1.168.50",
    "@workos-inc/node": "10.13.0",
    "@workos/authkit-tanstack-react-start": "0.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@workos/authkit-session": "0.7.0",
    "nitro": "3.0.260903-beta",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
